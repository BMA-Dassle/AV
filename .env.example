# Copy to .env.local (Next.js reads it automatically) and fill in.

# 1 = simulate everything (no Pandora token or DirecTV boxes needed)
MOCK=1
# DirecTV boxes: pandora (cloud host, needs Pandora's /v2/directv release) | shef (on-site host, direct) | mock
# Default: mock when MOCK=1, otherwise pandora. Use DIRECTV_VIA=mock with MOCK=0 to run the matrix live before Pandora's DirecTV release.
DIRECTV_VIA=
# Projector power: pandora (cloud host) | direct (on-site host, TCP to the projectors) | mock. Default like DIRECTV_VIA.
PROJECTOR_VIA=

# Preview gateway override (go2rtc), e.g. http://10.43.60.245:1984. Default: site.previewGateway, else Pandora's /v2/preview
PREVIEW_GATEWAY=

# Neon Postgres (shared floor state, activity log). Pooled URL from the Neon dashboard. Optional: without it state is per process.
DATABASE_URL=

# Bearer tokens the /api accepts (comma-separated). Tablets open the page once as ?token=<one of these>.
AV_APP_TOKENS=

# Pandora REST API (HDTV endpoints). Bearer JWT from the BMA/Pandora team.
PANDORA_BASE=https://bma-pandora-api.azurewebsites.net/v2
PANDORA_TOKEN=
# udp (default, port 6004) or tcp (port 6006) between Pandora and the AV nodes
PANDORA_TRANSPORT=udp

# DirecTV SHEF (receiver HTTP API), port 8080 on each box. Direct SHEF only works from an on-site host;
# on Vercel the DirecTV calls go through Pandora's /v2/directv/* once deployed.
SHEF_PORT=8080
SHEF_POLL_MS=10000

# Guide provider for /api/guide: tvmedia (default when TVMEDIA_API_KEY is set) or mock
GUIDE_PROVIDER=tvmedia
GUIDE_TIMEZONE=America/New_York
# TV Media (tvpassport) listings API. DirecTV Fort Myers-Naples lineup id: 36463D
TVMEDIA_API_KEY=
TVMEDIA_LINEUP=36463D
# stop calling TV Media for the month after this many calls (Intro plan is 1,000)
TVMEDIA_MONTHLY_CAP=900
